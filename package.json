{
  "name": "club-management",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app for managing club membership, activities, and the club board.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node tools/start-app.mjs",
